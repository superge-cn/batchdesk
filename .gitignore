# ── Rust ───────────────────────────────────────────────
/target/
**/target/

# ── Node / 前端 ─────────────────────────────────────────
node_modules/
dist/
*.local
# 无 WASM 环境下的界面行为探针产物（源码在 web/.probe，见其 README）
web/.probe/*.cjs

# ── Tauri ──────────────────────────────────────────────
src-tauri/gen/

# ── 依赖审计与 SBOM 产物（对齐方案 §4.10、§4.11.4）────────
/sbom/
/audit-output/
*.sbom.json

# ── fixtures：生成的样本不入库，只入库脚本与清单 ──────────
# 规则见 fixtures/README.md「入库策略」
fixtures/corpus/*/out/
fixtures/bench/*/out/

# ── 基准结果 ────────────────────────────────────────────
/bench-results/
/criterion/

# ── Python ─────────────────────────────────────────────
__pycache__/
*.pyc

# ── 编辑器与系统 ────────────────────────────────────────
.vscode/*
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# ── 临时/半成品文件（对齐方案 §4.3 的原子落盘命名习惯）────
*.tmp
*.part

# Playwright 产物
web/test-results/
web/playwright-report/
web/blob-report/

# ── 本机工具产生的目录（不是仓库内容）────────────────────
# .Trash-0/：部分桌面环境把删除的文件挪到挂载点根目录，出现在工作区里纯属巧合
# .workbuddy/：代理的工作记忆与会话数据（项目记忆有价值，但不是版本化产物）
.Trash-0/
.workbuddy/
